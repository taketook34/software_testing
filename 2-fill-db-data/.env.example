# Параметри підключення до MySQL на Aiven (Console → сервіс → Overview → Connection information).
# Скопіюй цей файл у .env і заповни значення.
#
# Можна заповнити або DB_SERVICE_URI, або окремі поля нижче.
# Якщо заповнено і те, і те, окремі поля мають пріоритет.

DB_SERVICE_URI=

DB_NAME=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=

# REQUIRED — шифроване з'єднання з перевіркою CA-сертифіката
DB_SSL_MODE=REQUIRED
# Шлях до CA certificate, завантаженого з Aiven (відносно цієї папки або абсолютний)
DB_CA_CERT=./ca.pem
